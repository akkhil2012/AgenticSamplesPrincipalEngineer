# Default demonstration uses no network and no credentials.
LLM_MODE=mock
# To enable an OpenAI-compatible Chat Completions endpoint:
# LLM_MODE=openai
# OPENAI_API_KEY=replace-in-your-shell-only
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=10
# This file is documentation; the program reads environment variables, not .env files.
